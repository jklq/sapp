{
  "name": "sapp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "sapp.angeltvedt.net", "custom_domain": true }],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "sapp", "database_id": "1d3d0bd6-0598-466a-b577-263bdf961d9f", "migrations_dir": "migrations" }
  ],
  // The Go backend used x-ai/grok-4-fast, which OpenRouter has since retired.
  "vars": { "OPENROUTER_MODEL": "x-ai/grok-4.3" },
  "queues": {
    "producers": [{ "binding": "CATEGORIZE", "queue": "sapp-categorize" }],
    "consumers": [{ "queue": "sapp-categorize", "max_batch_size": 1, "max_retries": 3 }]
  }
  // Secrets: JWT_SECRET_KEY, OPENROUTER_KEY
}
